let _settingsCache = null;

function getSettings() {
  if (_settingsCache) return _settingsCache;
  const out = Object.assign({}, SETTING_DEFAULTS);
  try {
    Db.rows(SHEET.SETTINGS).forEach(function (r) {
      if (r.key) out[String(r.key)] = String(r.value);
    });
  } catch (err) {
    logWarn('getSettings', 'Settings sheet unreadable, using defaults: ' + err);
  }
  _settingsCache = out;
  return out;
}

function getSetting(key) {
  return getSettings()[key];
}

function setSetting(key, value) {
  const rows = Db.rows(SHEET.SETTINGS);
  const idx = rows.map(function (r) { return String(r.key); }).indexOf(String(key));
  if (idx >= 0) {
    Db.update(SHEET.SETTINGS, 'key', key, { value: value });
  } else {
    Db.append(SHEET.SETTINGS, {
      key: key,
      value: value,
      note: SETTING_NOTES[key] || ''
    });
  }
  _settingsCache = null;
}

function invalidateSettingsCache() {
  _settingsCache = null;
}
